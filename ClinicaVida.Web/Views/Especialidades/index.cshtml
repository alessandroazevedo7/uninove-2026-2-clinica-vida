@model IEnumerable<Especialidade>

@{
    ViewData["Title"] = "Especialidades da Clínica Vida+";
    var contagem = (Dictionary<int, int>)ViewBag.MedicosPorEspecialidade;
}

<h1>@ViewData["Title"]</h1>

<ul class="list-group">
@foreach (var e in Model)
{
    <li class="list-group-item d-flex justify-content-between align-items-center">
        <a href="/Medicos?especialidadeId=@e.Id" class="text-decoration-none fw-bold">
            @e.Nome
        </a>
        <span class="badge bg-primary rounded-pill">
            @contagem[e.Id] médico(s)
        </span>
    </li>
}
</ul>